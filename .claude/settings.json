{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(gh pr merge*)",
      "PowerShell(gh pr merge*)",
      "Bash(git push --force*)",
      "PowerShell(git push --force*)",
      "Bash(git push -f*)",
      "PowerShell(git push -f*)",
      "Bash(git push origin main*)",
      "PowerShell(git push origin main*)",
      "Bash(git push origin HEAD:main*)",
      "PowerShell(git push origin HEAD:main*)",
      "Bash(dotnet ef database update*)",
      "PowerShell(dotnet ef database update*)",
      "Bash(dotnet*database update*)",
      "PowerShell(dotnet*database update*)",
      "Bash(dotnet*database drop*)",
      "PowerShell(dotnet*database drop*)",
      "Bash(dotnet*migrations remove*)",
      "PowerShell(dotnet*migrations remove*)",
      "Bash(dotnet user-secrets*)",
      "PowerShell(dotnet user-secrets*)",
      "Bash(gh auth token*)",
      "PowerShell(gh auth token*)",
      "Bash(gh auth status --show-token*)",
      "PowerShell(gh auth status --show-token*)",
      "Bash(env)",
      "PowerShell(env)",
      "Bash(printenv*)",
      "PowerShell(printenv*)",
      "Bash(Get-ChildItem env:*)",
      "PowerShell(Get-ChildItem env:*)",
      "Bash(docker compose config*)",
      "PowerShell(docker compose config*)",
      "Bash(cat *UserSecrets*)",
      "PowerShell(cat *UserSecrets*)",
      "Bash(type *UserSecrets*)",
      "PowerShell(type *UserSecrets*)",
      "Bash(Get-Content *UserSecrets*)",
      "PowerShell(Get-Content *UserSecrets*)",
      "Bash(cat *usersecrets*)",
      "PowerShell(cat *usersecrets*)",
      "Bash(type *usersecrets*)",
      "PowerShell(type *usersecrets*)",
      "Bash(Get-Content *usersecrets*)",
      "PowerShell(Get-Content *usersecrets*)",
      "Read(**/Microsoft/UserSecrets/**)",
      "Read(**/.microsoft/usersecrets/**)",
      "Read(**/.env)",
      "Read(//**/Microsoft/UserSecrets/**)",
      "Read(//**/.microsoft/usersecrets/**)",
      "Read(//**/.env)",
      "Bash(cat *.env)",
      "PowerShell(cat *.env)",
      "Bash(type *.env)",
      "PowerShell(type *.env)",
      "Bash(Get-Content *.env)",
      "PowerShell(Get-Content *.env)",
      "Edit(**/Microsoft/UserSecrets/**)",
      "Edit(**/.microsoft/usersecrets/**)",
      "Edit(//**/Microsoft/UserSecrets/**)",
      "Edit(//**/.microsoft/usersecrets/**)",
      "Edit(**/.env)",
      "Edit(//**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.production)",
      "Read(//**/.env.local)",
      "Read(//**/.env.production)",
      "Edit(**/.env.local)",
      "Edit(**/.env.production)",
      "Edit(//**/.env.local)",
      "Edit(//**/.env.production)",
      "Bash(cat *.env.local)",
      "PowerShell(cat *.env.local)",
      "Bash(type *.env.local)",
      "PowerShell(type *.env.local)",
      "Bash(Get-Content *.env.local)",
      "PowerShell(Get-Content *.env.local)",
      "Bash(cat *.env.production)",
      "PowerShell(cat *.env.production)",
      "Bash(type *.env.production)",
      "PowerShell(type *.env.production)",
      "Bash(Get-Content *.env.production)",
      "PowerShell(Get-Content *.env.production)",
      "Read(**/appsettings.Development.json)",
      "Read(**/appsettings.Production.json)",
      "Read(**/appsettings.Local.json)",
      "Read(**/docker-compose.override.yml)",
      "Read(**/docker-compose.override.yaml)",
      "Read(//**/appsettings.Development.json)",
      "Read(//**/appsettings.Production.json)",
      "Read(//**/appsettings.Local.json)",
      "Read(//**/docker-compose.override.yml)",
      "Read(//**/docker-compose.override.yaml)",
      "Edit(**/appsettings.Development.json)",
      "Edit(**/appsettings.Production.json)",
      "Edit(**/appsettings.Local.json)",
      "Edit(**/docker-compose.override.yml)",
      "Edit(**/docker-compose.override.yaml)",
      "Edit(//**/appsettings.Development.json)",
      "Edit(//**/appsettings.Production.json)",
      "Edit(//**/appsettings.Local.json)",
      "Edit(//**/docker-compose.override.yml)",
      "Edit(//**/docker-compose.override.yaml)",
      "Bash(cat *appsettings.Development.json)",
      "PowerShell(cat *appsettings.Development.json)",
      "Bash(type *appsettings.Development.json)",
      "PowerShell(type *appsettings.Development.json)",
      "Bash(Get-Content *appsettings.Development.json)",
      "PowerShell(Get-Content *appsettings.Development.json)",
      "Bash(cat *appsettings.Production.json)",
      "PowerShell(cat *appsettings.Production.json)",
      "Bash(type *appsettings.Production.json)",
      "PowerShell(type *appsettings.Production.json)",
      "Bash(Get-Content *appsettings.Production.json)",
      "PowerShell(Get-Content *appsettings.Production.json)",
      "Bash(cat *appsettings.Local.json)",
      "PowerShell(cat *appsettings.Local.json)",
      "Bash(type *appsettings.Local.json)",
      "PowerShell(type *appsettings.Local.json)",
      "Bash(Get-Content *appsettings.Local.json)",
      "PowerShell(Get-Content *appsettings.Local.json)",
      "Bash(cat *docker-compose.override.yml)",
      "PowerShell(cat *docker-compose.override.yml)",
      "Bash(type *docker-compose.override.yml)",
      "PowerShell(type *docker-compose.override.yml)",
      "Bash(Get-Content *docker-compose.override.yml)",
      "PowerShell(Get-Content *docker-compose.override.yml)",
      "Bash(cat *docker-compose.override.yaml)",
      "PowerShell(cat *docker-compose.override.yaml)",
      "Bash(type *docker-compose.override.yaml)",
      "PowerShell(type *docker-compose.override.yaml)",
      "Bash(Get-Content *docker-compose.override.yaml)",
      "PowerShell(Get-Content *docker-compose.override.yaml)",
      "Bash(git *--output*)",
      "PowerShell(git *--output*)"
    ],
    "ask": [
      "Bash(gh issue create*)",
      "PowerShell(gh issue create*)",
      "Bash(gh pr create*)",
      "PowerShell(gh pr create*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/rule-injector.sh\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/rule-injector.sh\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/rule-injector.sh\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/rule-injector.sh\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/rule-injector.sh\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/rule-injector.sh\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/rule-injector.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/rule-injector.sh\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
