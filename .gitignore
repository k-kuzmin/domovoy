## ============================================================
## Домовой — .gitignore
## Первый рубеж защиты: приватные данные и секреты не попадают
## в дерево ни в одной копии репозитория (ТЗ 5.1.1).
## ============================================================

## ------------------------------------------------------------
## Секреты и приватные данные проекта (ТЗ 5.1.2, 5.1.3)
## ------------------------------------------------------------

# Конфигурация с реальными значениями
appsettings.Development.json
appsettings.Production.json
appsettings.Local.json
.env
.env.local
.env.production
docker-compose.override.yml
docker-compose.override.yaml

# Реестр сущностей, профиль дома, правила проактивности.
# Чувствительнее токенов: вместе дают планировку, состав жильцов
# и расположение датчиков (ТЗ 5.1.3).
config/*.yaml
config/*.yml
config/*.md
config/*.json
!config/*.example.*

# Локальные БД, дампы, бэкапы HA
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.sql.gz
*.dump
backups/

# Секреты Cloudflare Tunnel
*.pem
*.key
!**/*.key.example
cloudflared/
.cloudflared/

