<Project>

  <!--
    Общие настройки всех проектов решения.

    Правки здесь, а не в отдельных .csproj: расхождение настроек между
    проектами — источник ошибок, которые видны только в одном из них.
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!--
      Предупреждение — это ошибка, которую пока не заметили.
      Следствие, о котором легко забыть: метод `async Task<T>` с телом
      `throw new NotImplementedException()` даёт CS1998 и роняет сборку.
      Заглушки объявлять не async.
    -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningLevel>9999</WarningLevel>

    <!-- Анализаторы .NET и правила стиля проверяются при сборке, а не
         только в IDE: иначе стиль соблюдается лишь у того, кто открыл
         проект в правильном редакторе. -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>Recommended</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!--
      IDE0005 (лишние using) работает при сборке только если включён
      файл документации — известное ограничение Roslyn. Без него сборка
      падает с ошибкой EnableGenerateDocumentationFile.

      CS1591 при этом отключён: XML-документация нужна нам как побочный
      эффект для анализатора, а не как публикуемая справка, и требовать
      комментарий у каждого публичного члена смысла нет.
    -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <!-- Воспроизводимая сборка -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>

    <!-- Метаданные -->
    <Product>Домовой</Product>
    <Authors>Konstantin Kuzmin</Authors>
    <Company>Konstantin Kuzmin</Company>
    <Copyright>Copyright (c) 2026 Konstantin Kuzmin</Copyright>
    <RepositoryUrl>https://github.com/k-kuzmin/domovoy</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <NeutralLanguage>ru</NeutralLanguage>

    <!-- Библиотеки решения в NuGet не публикуются -->
    <IsPackable>false</IsPackable>

    <!-- Строгий режим восстановления пакетов -->
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>

    <!--
      Предупреждения аудита остаются видимыми, но сборку не ломают:
      уязвимость в транзитивном пакете появляется в день, когда код
      никто не трогал, и «красная» сборка на ровном месте приучает
      игнорировать её вместо того, чтобы читать.
    -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
  </PropertyGroup>

  <!--
    Тестовые проекты: часть правил анализаторов для тестов бессмысленна
    (публичные типы без документации, отсутствие CancellationToken в
    вызовах assert-хелперов).
  -->
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('Tests'))">
    <IsTestProject>true</IsTestProject>
    <NoWarn>$(NoWarn);CA1707;CA2007;CA1861</NoWarn>
  </PropertyGroup>

</Project>
