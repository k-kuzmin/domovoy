# ============================================================
# Домовой — пример переменных окружения
#
# Скопировать в .env и заполнить. Файл .env закрыт .gitignore.
#
# Значения ниже — рабочие: docker compose up на них поднимается на
# чистой машине. Внешние учётные данные пустые или фиктивные, и это
# нормально — /health покажет для них «не сконфигурировано», сервис не
# упадёт.
#
# Реальных доменов, локальных адресов и токенов здесь нет и быть не
# должно. Секреты приходят сюда только на целевой машине.
#
# Разметка для обновления (deploy/envfile.sh sync): строка
# «# env-sync: generate» над ключом — при досинхронизации .env каталога
# развёртывания значение генерируется; «# env-sync: owner» — ключ знает
# только владелец, обновление его не дописывает, а просит заполнить.
# Ключ без разметки дописывается значением отсюда.
# ============================================================

# ------------------------------------------------------------
# Стек
# ------------------------------------------------------------
COMPOSE_PROJECT_NAME=domovoy
ASPNETCORE_ENVIRONMENT=Production

# Порт, на котором Backend слушает на хосте
API_HTTP_PORT=18080

# ------------------------------------------------------------
# PostgreSQL
#
# Пароль ниже — значение для локального запуска примера. На целевой
# машине заменить: база хранит диалоги, аудит и память, то есть всё,
# что агент знает о доме.
# ------------------------------------------------------------
POSTGRES_DB=domovoy
POSTGRES_USER=domovoy
# env-sync: owner
POSTGRES_PASSWORD=domovoy
POSTGRES_PORT=5432

# ------------------------------------------------------------
# Администрирование устройств (запись 0032)
#
# AUTH_ADMIN_TOKEN — общий секрет админ-эндпоинтов /api/v1/admin/…:
# выпуск кода привязки, список устройств, отзыв. Случайная строка не
# короче 32 символов, например openssl rand -base64 32, только на
# целевой машине. Пусто или плейсхолдер — админ-эндпоинты закрыты,
# короче 32 — api не стартует.
# ------------------------------------------------------------
# env-sync: generate
AUTH_ADMIN_TOKEN=<admin-token>

# ------------------------------------------------------------
# Home Assistant
#
# Адрес — имя сервиса в сети Docker либо адрес в локальной сети.
# Наружу Home Assistant не выставляется (NFR-SEC-2).
#
# HA_TOKEN — long-lived access token отдельного служебного
# пользователя (FR-HA-2). Значение ниже фиктивное: в угловых скобках
# оно считается незаполненным, /health покажет «не сконфигурировано».
# Настоящий токен кладётся только в .env на целевой машине.
# ------------------------------------------------------------
HA_BASE_URL=http://homeassistant:8123
# env-sync: owner
HA_TOKEN=<ha-long-lived-token>

# Порт веб-интерфейса HA на хосте. Используется, только когда HA
# поднят из этого стека: docker compose --profile ha up -d. Проброса
# этого порта на роутере быть не должно (NFR-SEC-2).
HA_HTTP_PORT=8123

# Раскомментировать, чтобы обычный docker compose up всегда поднимал
# и Home Assistant, без ключа --profile ha.
# COMPOSE_PROFILES=ha

# ------------------------------------------------------------
# Провайдер LLM
#
# Провайдер задаётся конфигурацией целиком. Переключение на резервный —
# смена LLM_BASE_URL, LLM_API_KEY, LLM_MODEL и LLM_DIALECT.
# LLM_DIALECT: OpenAiCompatible | Yandex
#
# LLM_PROXY — необязательный SOCKS-прокси для этого клиента. Нужен,
# когда на хосте активен VPN и провайдер отклоняет запросы по региону
# адреса источника (AR-1.3). Маршрутизация хоста при этом не меняется.
# ------------------------------------------------------------
LLM_BASE_URL=https://llm.example.com/v1
# env-sync: owner
LLM_API_KEY=
LLM_MODEL=change-me
LLM_DIALECT=OpenAiCompatible
LLM_PROXY=

# Месячный потолок токенов. При достижении — деградация в режим
# «только быстрый роутер» (NFR-COST-2). 0 отключает ограничение.
LLM_MONTHLY_TOKEN_BUDGET=0

# ------------------------------------------------------------
# Push через ntfy
#
# NTFY_TOPIC функционально является паролем: знающий имя топика читает
# уведомления и отправляет свои. Случайная строка достаточной энтропии,
# генерируется при настройке и никогда не попадает в репозиторий.
# ------------------------------------------------------------
NTFY_BASE_URL=https://push.example.com
# env-sync: owner
NTFY_TOPIC=

# ------------------------------------------------------------
# Голос
#
# VOICE_TTS_URL пусто = озвучка отключена (FR-VOICE-4).
# ------------------------------------------------------------
VOICE_STT_URL=http://whisper:9000
VOICE_TTS_URL=
VOICE_LANGUAGE=ru

# ------------------------------------------------------------
# Проактивность
#
# Выключено по умолчанию: на этапе каркаса поток событий Home Assistant
# ещё не реализован. Включать вместе с этапом 3.
# ------------------------------------------------------------
PROACTIVITY_ENABLED=false

# ------------------------------------------------------------
# Бэкап
#
# Читает только ops/backup/backup.sh (и restore.sh --check без --from)
# при каждом запуске. Backend их не читает: в контейнер api они попадают
# только потому, что compose передаёт ему весь .env (env_file).
# Задача Планировщика ставится ops/backup/install-schedule.ps1, правка
# здесь действует со следующего прогона без переустановки.
#
# BACKUP_DIR — существующий каталог на внешнем носителе, вне клона.
# Значение в угловых скобках считается незаполненным: бэкап откажет.
# BACKUP_MAX_SIZE_GB — лимит суммарного объёма бэкапов на носителе в
# целых ГБ; пусто — без лимита, хранятся 14 последних.
# ------------------------------------------------------------
# env-sync: owner
BACKUP_DIR=<внешний-диск>/domovoy-backups
BACKUP_MAX_SIZE_GB=

# ------------------------------------------------------------
# Развёртывание
#
# Эти ключи пишет deploy/update.sh в .env каталога развёртывания:
# COMPOSE_FILE подключает deploy/docker-compose.deploy.yml (и
# docker-compose.override.yml, если он есть), а образы api и migrate
# берутся из реестра по тегу коммита. В клоне разработки они не
# задаются: compose собирает api из исходников, как раньше. Руками не
# править — следующее обновление перепишет их.
# ------------------------------------------------------------
# COMPOSE_FILE=docker-compose.yml:deploy/docker-compose.deploy.yml
# DOMOVOY_IMAGE_REPO=ghcr.io/<владелец>
# DOMOVOY_IMAGE_TAG=sha-<40 hex коммита>
